{
    "name": "swew/test.phar",
    "description": "A test framework that is designed to fix the fatal flaw of other test frameworks.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "TDD",
        "testing",
        "fast",
        "lightweight",
        "informative interface"
    ],
    "authors": [
        {
            "name": "AVIL13",
            "email": "avil@swew.app"
        }
    ],
    "bin": [
        "t",
        "swew-test.phar"
    ],
    "autoload": {
        "exclude-from-classmap": [
            "spec",
            "/Tests/",
            "/test/",
            "/tests/"
        ]
    },
    "archive": {
        "exclude": [
            "tests",
            "swew.json"
        ]
    },
    "conflict": {
        "swew/test": "*"
    },
    "require": {
        "php": ">=8.1",
        "ext-json": "*"
    },
    "scripts": {
        "build": "@php -d phar.readonly=0 -d error_reporting='E_ALL & ~E_DEPRECATED & ~E_USER_DEPRECATED' ./box.phar compile --no-parallel --no-restart",
        "test": "./t"
    }
}
